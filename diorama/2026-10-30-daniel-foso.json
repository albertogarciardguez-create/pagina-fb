  "scenes": [
    {"say": "Todo un imperio se arrodilló ante un rey... Un solo hombre se negó.",
     "img": ["p01a", "p01b"], "split": true, "move": "in", "acto": 1, "mus": "menor",
     "titles": [{"b": "Todos se arrodillaron", "l": "ante el rey", "pos": "topright"},
                {"b": "Daniel se arrodilló", "l": "ante Dios", "pos": "left", "color": "arena", "s": 1}],
     "sfx": [{"k": "tambor", "s": 0, "d": -0.3}]},
    {"say": "Daniel era el hombre más confiable de Babilonia.",
     "img": ["p02"], "move": "right", "acto": 2, "mus": "menor",
     "titles": [{"b": "Daniel", "l": "el más confiable de Babilonia"}]},
    {"say": "Tan íntegro, que sus enemigos no le encontraron una sola falta.",
     "img": ["p03"], "move": "in", "acto": 2, "mus": "menor",
     "titles": [{"b": "Ni una sola falta", "l": "y eso les molestaba"}]},
    {"say": "Así que le pusieron una trampa. Una ley: durante treinta días, nadie podría orar a ningún dios... Solo al rey.",
     "img": ["p04"], "move": "in", "acto": 2, "mus": "menor",
     "titles": [{"b": "Una ley", "l": "para atraparlo"}],
     "dial": {"tipo": "dias", "n": 30, "sub": "DÍAS", "s": 1, "dur": 2.0, "y": 830, "r": 230},
     "sfx": [{"k": "sello", "s": 1}]},
    {"say": "Daniel lo supo. Fue a su casa, abrió la ventana... y oró. Tres veces al día. Como siempre.",
     "img": ["p05"], "move": "in", "acto": 3, "mus": "menor", "nivel": 0.7,
     "titles": [{"b": "Abrió la ventana", "l": "y oró como siempre", "pos": "topleft", "color": "arena", "s": 1}]},
    {"say": "Lo arrojaron al foso de los leones.",
     "img": ["p06"], "move": "down", "fade": true, "acto": 4, "mus": "foso",
     "titles": [{"b": "Al foso", "l": "de los leones"}],
     "sfx": [{"k": "rugido", "s": 0, "at": 0.6}]},
    {"say": "Sellaron la piedra.",
     "img": ["p07"], "move": "none", "acto": 4, "mus": "foso", "polvo": 0.5,
     "sfx": [{"k": "piedra", "s": 0, "d": -0.2}]},
    {"say": "Esa noche, el rey no pudo dormir.",
     "img": ["p08"], "move": "in", "acto": 4, "mus": "foso", "nivel": 0.8,
     "titles": [{"b": "El rey", "l": "no pudo dormir"}],
     "dial": {"tipo": "noche", "sub": "NOCHE", "s": 0, "at": 0.3, "vuelta": 2.5, "y": 760, "r": 170}},
    {"say": "Al amanecer corrió al foso y gritó: ¡Daniel!...",
     "img": ["p09"], "move": "shake", "fade": true, "acto": 5, "mus": "foso", "corte": true,
     "titles": [{"b": "¡Daniel!", "pos": "center", "big": true, "at": 0.68}]},
    {"say": "Y desde la oscuridad, una voz respondió: \"Mi Dios envió a su ángel, y cerró la boca de los leones.\"",
     "img": ["p10"], "move": "up", "acto": 5, "mus": "mayor",
     "titles": [{"b": "Cerró la boca", "l": "de los leones", "at": 0.5}]},
    {"say": "No tenía un solo rasguño. Porque confió en su Dios.",
     "img": ["p11"], "move": "out", "acto": 5, "mus": "mayor",
     "titles": [{"b": "Ni un rasguño", "l": "porque confió"}]},
    {"say": "Tus principios no se prueban cuando es fácil... Se prueban en el foso.",
     "img": ["p12"], "move": "up", "acto": 5, "mus": "mayor", "nivel": 1.25,
     "titles": [{"b": "Tus principios", "l": "se prueban en el foso", "color": "arena"}]},
    {"say": "¿Tú te arrodillarías ante el rey?",
     "tipo": "cierre", "mus": "mayor",
     "titles": [{"b": "¿Tú te arrodillarías", "l": "ante el rey?", "pos": "q"}]}
