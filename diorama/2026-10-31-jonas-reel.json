  "scenes": [
    {"say": "Dios le pidió ir al oriente... Y él compró un boleto al occidente.",
     "img": ["v01a", "v01b"], "split": true, "move": "in", "acto": 1, "mus": "menor",
     "titles": [{"b": "Dios dijo: Nínive", "l": "al oriente", "pos": "topright"},
                {"b": "Jonás huyó", "l": "al occidente", "pos": "lowleft", "s": 1}],
     "sfx": [{"k": "tambor", "s": 0, "d": -0.3}]},
    {"say": "Se subió a un barco. Y en pleno mar, se desató una tormenta que casi lo parte en dos.",
     "img": ["v02"], "move": "shake", "acto": 2, "mus": "foso", "ambiente": "olas",
     "titles": [{"b": "La tormenta", "l": "que él provocó", "s": 1}],
     "sfx": [{"k": "trueno", "s": 1, "at": 0.3}]},
    {"say": "Mientras los marineros luchaban por sus vidas... Jonás dormía en el fondo del barco.",
     "img": ["v03"], "move": "in", "acto": 2, "mus": "foso", "ambiente": "olas",
     "titles": [{"b": "Jonás dormía", "l": "en el fondo del barco", "s": 1}]},
    {"say": "Cuando lo descubrieron, dijo la verdad: Échenme al mar. Es por mi culpa.",
     "img": ["v04"], "move": "in", "acto": 2, "mus": "foso", "ambiente": "olas",
     "titles": [{"b": "Échenme al mar", "l": "es por mi culpa", "at": 0.5}]},
    {"say": "Lo lanzaron al agua... Y el mar se calmó.",
     "img": ["v05"], "move": "down", "acto": 2, "mus": "foso", "corte": true,
     "titles": [{"b": "El mar", "l": "se calmó", "s": 1}],
     "sfx": [{"k": "agua", "s": 0, "at": 0.6}]},
    {"say": "Pero Dios preparó un gran pez. Y se lo tragó.",
     "img": ["v06"], "move": "down", "fade": true, "acto": 3, "mus": "foso",
     "titles": [{"b": "Un gran pez", "l": "preparado por Dios"}],
     "sfx": [{"k": "rugido", "s": 1, "g": 0.6}]},
    {"say": "Tres días y tres noches en la oscuridad. Y ahí, por fin, oró.",
     "img": ["v07"], "move": "in", "acto": 3, "mus": "menor", "nivel": 0.7, "polvo": 0.6,
     "titles": [{"b": "Por fin", "l": "oró", "s": 1}],
     "dial": {"tipo": "dias", "n": 3, "sub": "DÍAS", "s": 0, "dur": 1.2, "y": 860, "r": 210}},
    {"say": "El pez lo arrojó en la playa. Vivo.",
     "img": ["v08"], "move": "out", "acto": 3, "mus": "mayor",
     "titles": [{"b": "Vivo", "l": "y con otra oportunidad", "s": 1}],
     "sfx": [{"k": "agua", "s": 0, "at": 0.5}]},
    {"say": "Y Dios le habló por segunda vez. Con la misma misión.",
     "img": ["v09"], "move": "up", "acto": 4, "mus": "mayor",
     "titles": [{"b": "Por segunda vez", "l": "la misma misión"}]},
    {"say": "Esta vez obedeció. Y la ciudad más cruel de su tiempo se arrepintió.",
     "img": ["v10"], "move": "in", "acto": 4, "mus": "mayor",
     "titles": [{"b": "Nínive", "l": "se arrepintió", "s": 1}]},
    {"say": "Huir siempre te lleva hacia abajo... Obedecer, aunque dé miedo, te devuelve a la luz.",
     "img": ["v11"], "move": "up", "acto": 5, "mus": "mayor", "nivel": 1.25,
     "titles": [{"b": "Huir te hunde", "l": "obedecer te levanta"}]},
    {"say": "¿De qué estás huyendo tú?",
     "tipo": "cierre", "mus": "mayor",
